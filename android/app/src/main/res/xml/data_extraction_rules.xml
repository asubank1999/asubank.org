<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the sign-in token (in ab.xml) stays off cloud backups and phone-to-phone transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ab.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ab.xml" />
    </device-transfer>
</data-extraction-rules>
